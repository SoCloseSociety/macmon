<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: the dark ground at ~72% (lets the wallpaper through), a light
     hairline at 20%. Lunar text stays light and keeps AA over any wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/verre_fond" />
    <stroke android:width="1dp" android:color="@color/verre_ligne" />
    <corners android:radius="@dimen/wg_radius" />
</shape>
