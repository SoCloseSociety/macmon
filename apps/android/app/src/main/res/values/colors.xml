<?xml version="1.0" encoding="utf-8"?>
<!-- AegisForge widget palette. Re-implemented from the Sentinel House "Lunar"
     tokens (KIT-WIDGETS.md) so the fleet reads as one system: near-black cool
     ground, a single mint accent that is also the OK state, amber for attention,
     rose for alert. Each verdict colour has a dark ink for text drawn on it
     (measured AA). No fleet code is copied; these are the documented hex values. -->
<resources>
    <color name="ground">#0B0F14</color>
    <color name="ground_2">#10161D</color>
    <color name="surface">#151C25</color>
    <color name="line">#263241</color>
    <color name="text">#EEF3F8</color>
    <color name="text_2">#9FB0C2</color>

    <color name="mint">#34E5A0</color>
    <color name="mint_ink">#04221A</color>
    <color name="amber">#E8B13A</color>
    <color name="amber_ink">#2A1E05</color>
    <color name="alert">#FB7185</color>
    <color name="alert_ink">#2B0A10</color>

    <!-- veil over an illustration: ground at 65% top to 85% bottom, keeps text
         at 4.5:1 over any wallpaper. Kept for a future "art background" option. -->
    <color name="veil_top">#A60B0F14</color>
    <color name="veil_bottom">#D90B0F14</color>
</resources>
