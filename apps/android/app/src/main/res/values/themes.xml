<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A plain dark theme for the one activity. DeviceDefault keeps the APK free
         of the AppCompat / Material dependency (zero third-party runtime deps). -->
    <style name="Theme.AegisForge" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
    </style>

    <!-- A selectable chip button on the config screen (equal width in its row). -->
    <style name="CfgChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
