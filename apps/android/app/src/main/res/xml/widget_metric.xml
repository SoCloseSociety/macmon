<?xml version="1.0" encoding="utf-8"?>
<!-- AegisForge single-metric widget. Natural at 2x2; the metric and style are
     chosen on the config screen before it is added. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_card_s"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_card_s"
    android:description="@string/widget_metric_desc"
    android:configure="co.soclose.aegisforge.ChoixWidgetActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
