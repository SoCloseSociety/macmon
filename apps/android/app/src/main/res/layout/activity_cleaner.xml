<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="@string/cleaner_title"
            android:textAllCaps="true"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cleaner_tag"
            android:textColor="@color/mint"
            android:textSize="13sp" />

        <!-- permission gate -->
        <LinearLayout
            android:id="@+id/perm_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/perm_needed"
                android:textColor="@color/text_2"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_grant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/mint"
                android:text="@string/perm_grant"
                android:textColor="@color/mint_ink"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- scan + results -->
        <LinearLayout
            android:id="@+id/scan_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_analyze"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/mint"
                android:text="@string/btn_analyze"
                android:textColor="@color/mint_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_2"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_clean"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/mint"
                android:text="@string/btn_clean"
                android:textColor="@color/mint_ink"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_wipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/surface"
                android:text="@string/btn_wipe"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/wipe_note"
                android:textColor="@color/text_2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
