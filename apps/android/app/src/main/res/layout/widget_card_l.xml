<?xml version="1.0" encoding="utf-8"?>
<!-- Large card (4x3+): title + verdict pill on top, the big score with its sub,
     then the full list of lines, and the footer. Same id set as the other two
     cards. Only RemoteViews-inflatable views. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/wg_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wg_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/text_2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/wg_verdict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/pill_neutral"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wg_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/wg_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_2"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_lines"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/wg_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/text_2"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
