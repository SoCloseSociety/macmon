<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/main_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="@string/main_title"
            android:textAllCaps="true"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_tag"
            android:textColor="@color/mint"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/main_body"
            android:textColor="@color/text_2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_healthcheck"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/mint"
            android:text="@string/hc_open"
            android:textColor="@color/mint_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clean_open"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/surface"
            android:text="@string/clean_open"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/btn_apps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/surface"
            android:text="@string/apps_open"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/btn_dupes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/surface"
            android:text="@string/dupes_open"
            android:textColor="@color/text" />

        <Switch
            android:id="@+id/smart_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/smart_label"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/smart_note"
            android:textColor="@color/text_2"
            android:textSize="11sp" />

        <Button
            android:id="@+id/main_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/surface"
            android:text="@string/main_refresh"
            android:textColor="@color/mint" />

        <TextView
            android:id="@+id/main_snapshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_2"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
