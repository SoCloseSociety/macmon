<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The widget needs only this "normal" permission: the network type for the
         Network line. Battery, storage, memory and lock state need none. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The CLEANER needs file access to scan shared storage for junk. On
         Android 11+ this is All Files Access (a special grant the user makes in
         Settings); on older versions it is the legacy storage permission. It can
         never reach another app's sandbox (Android/data, Android/obb): the OS
         blocks that even with All Files Access. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Smart Cleaning posts a notification when junk builds up (13+ asks at
         runtime), and reschedules its background scan after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- App manager lists installed apps. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Self-update ONLY: reach the public GitHub release over HTTPS (the one
         network feature, used only on an explicit Check), and hand the signed APK
         to the system installer (which still prompts the user). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AegisForge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HealthCheckActivity"
            android:exported="false"
            android:label="@string/hc_title"
            android:theme="@style/Theme.AegisForge" />

        <activity
            android:name=".UpdaterActivity"
            android:exported="false"
            android:label="@string/upd_title"
            android:theme="@style/Theme.AegisForge" />

        <activity
            android:name=".CleanerActivity"
            android:exported="false"
            android:label="@string/cleaner_title"
            android:theme="@style/Theme.AegisForge" />

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:label="@string/apps_title"
            android:theme="@style/Theme.AegisForge" />

        <activity
            android:name=".DuplicatesActivity"
            android:exported="false"
            android:label="@string/dupes_title"
            android:theme="@style/Theme.AegisForge" />

        <service
            android:name=".SmartCleanJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".DailyScanReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ChoixWidgetActivity"
            android:exported="true"
            android:theme="@style/Theme.AegisForge">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".HealthWidget"
            android:exported="false"
            android:label="@string/widget_health_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_health" />
        </receiver>

        <receiver
            android:name=".MetricWidget"
            android:exported="false"
            android:label="@string/widget_metric_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_metric" />
        </receiver>
    </application>
</manifest>
